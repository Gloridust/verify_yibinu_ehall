from typing import Callable, Optional, Tuple, TypedDict, Dict

DEFAULT_BASE_URL: str
__version__: str

class AuthError(Exception): ...
class CaptchaRequired(AuthError):
    image: bytes  # 仅由 YibinuAuth 在没有 solver 时附加
class SliderCaptchaUnsupported(AuthError): ...
class PageStructureError(AuthError): ...
class UnexpectedResponseError(AuthError): ...
class NetworkError(AuthError): ...
class InvalidArgumentError(AuthError): ...

class LoginForm(TypedDict):
    fields: Dict[str, str]
    salt: str

class LoginPage(TypedDict):
    captcha_switch: str
    front_back_key: str
    password_form: Optional[LoginForm]
    sms_form: Optional[LoginForm]

class LoginResult:
    success: bool
    message: str
    redirect: Optional[str]
    def __bool__(self) -> bool: ...

class SmsResult:
    sent: bool
    code: str
    message: str
    retry_after: Optional[int]
    def __bool__(self) -> bool: ...

class Client:
    def __init__(self, *, base_url: Optional[str] = ..., service: Optional[str] = ...,
                 timeout: int = 10, verify_tls: bool = True, use_env_proxy: bool = True) -> None: ...
    def load_login_page(self) -> LoginPage: ...
    def need_captcha(self, username: str) -> bool: ...
    def fetch_captcha(self) -> bytes: ...
    def login_with_password(self, username: str, password: str, captcha: Optional[str] = None) -> LoginResult: ...
    def send_sms_code(self, mobile: str, captcha: str) -> SmsResult: ...
    def login_with_sms(self, mobile: str, dynamic_code: str) -> LoginResult: ...

CaptchaSolver = Callable[[bytes], str]

class YibinuAuth:
    captcha_solver: Optional[CaptchaSolver]
    client: Client
    def __init__(self, timeout: int = 10, verify_tls: bool = True,
                 captcha_solver: Optional[CaptchaSolver] = None, **client_kwargs) -> None: ...
    def load_login_page(self) -> LoginPage: ...
    def need_captcha(self, username: str) -> bool: ...
    def fetch_captcha(self) -> bytes: ...
    def login_with_password(self, username: str, password: str, captcha: Optional[str] = None) -> Tuple[bool, str]: ...
    def send_sms_code(self, mobile: str, captcha: Optional[str] = None) -> Tuple[bool, str]: ...
    def login_with_sms(self, mobile: str, dynamic_code: str) -> Tuple[bool, str]: ...

def encrypt_password(plain: str, salt: str) -> str: ...
def verify_login(username: str, password: str, timeout: int = 10,
                 captcha_solver: Optional[CaptchaSolver] = None, verify_tls: bool = True,
                 **client_kwargs) -> Tuple[bool, str]: ...
def verify_sms_login(mobile: str, code_provider: Callable[[], str], timeout: int = 10,
                     captcha_solver: Optional[CaptchaSolver] = None, verify_tls: bool = True,
                     **client_kwargs) -> Tuple[bool, str]: ...
def main(argv: Optional[list] = None) -> int: ...
